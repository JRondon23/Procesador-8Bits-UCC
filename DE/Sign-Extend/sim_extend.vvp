#! /usr/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib64/ivl/system.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib64/ivl/v2005_math.vpi";
:vpi_module "/usr/lib64/ivl/va_math.vpi";
:vpi_module "/usr/lib64/ivl/v2009.vpi";
S_0x559aed8f3f80 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x559aed8f4110 .scope module, "tb_sign_extend" "tb_sign_extend" 3 3;
 .timescale -9 -12;
v0x559aed907390_0 .net "dato_out", 7 0, v0x559aed8b97a0_0;  1 drivers
v0x559aed907450_0 .var "op_code", 7 0;
S_0x559aed8b9550 .scope module, "dut" "sign_extend" 3 10, 4 1 0, S_0x559aed8f4110;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "op_code";
    .port_info 1 /OUTPUT 8 "dato_out";
v0x559aed8b97a0_0 .var "dato_out", 7 0;
v0x559aed907250_0 .net "op_code", 7 0, v0x559aed907450_0;  1 drivers
E_0x559aed8f4f60 .event anyedge, v0x559aed907250_0;
    .scope S_0x559aed8b9550;
T_0 ;
Ewait_0 .event/or E_0x559aed8f4f60, E_0x0;
    %wait Ewait_0;
    %load/vec4 v0x559aed907250_0;
    %parti/s 1, 7, 4;
    %cmpi/e 1, 0, 1;
    %flag_get/vec4 4;
    %jmp/0 T_0.2, 4;
    %load/vec4 v0x559aed907250_0;
    %parti/s 1, 6, 4;
    %pushi/vec4 1, 0, 1;
    %cmp/e;
    %flag_get/vec4 4;
    %and;
T_0.2;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %load/vec4 v0x559aed907250_0;
    %parti/s 4, 2, 3;
    %concat/vec4; draw_concat_vec4
    %store/vec4 v0x559aed8b97a0_0, 0, 8;
    %jmp T_0.1;
T_0.0 ;
    %pushi/vec4 0, 0, 6;
    %load/vec4 v0x559aed907250_0;
    %parti/s 2, 2, 3;
    %concat/vec4; draw_concat_vec4
    %store/vec4 v0x559aed8b97a0_0, 0, 8;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x559aed8f4110;
T_1 ;
    %vpi_call/w 3 18 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 19 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x559aed8f4110 {0 0 0};
    %vpi_call/w 3 22 "$monitor", "Tiempo=%0t | op_code=%b | dato_out=%b (Hex: %h)", $time, v0x559aed907450_0, v0x559aed907390_0, v0x559aed907390_0 {0 0 0};
    %pushi/vec4 232, 0, 8;
    %store/vec4 v0x559aed907450_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 60, 0, 8;
    %store/vec4 v0x559aed907450_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 139, 0, 8;
    %store/vec4 v0x559aed907450_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x559aed907450_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 48 "$finish" {0 0 0};
    %end;
    .thread T_1;
